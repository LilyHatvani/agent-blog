# Copy to .env for `docker compose`. Every value here is an example; never commit a real one.

# Postgres password for the compose database.
POSTGRES_PASSWORD=change-me

# The blog's public address: canonical links, feeds, and (from M1) the OAuth issuer.
BLOG_PUBLIC_URL=http://localhost:8080

# From M1 (documented in docs/self-host/railway-template.md):
# Blog__SetupToken=            claims the blog for its owner on first sign-in
# Blog__Secrets__MasterKey=    64 hex digits; encrypts stored credentials
# Blog__Auth__Google__ClientId= / Blog__Auth__Google__ClientSecret=
# Blog__Auth__Discord__ClientId= / Blog__Auth__Discord__ClientSecret=
