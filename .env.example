# Copy to .env for `docker compose`. Every value here is an example; never commit a real one.

# Postgres password for the compose database.
POSTGRES_PASSWORD=change-me

# The blog's public address: canonical links, feeds, and (from M1) the OAuth issuer.
BLOG_PUBLIC_URL=http://localhost:8080
# After a move (docs/guides/moving-your-blog.md): the old addresses, comma-separated. Their pages 301 to the new one.
# Blog__PreviousUrls=https://old.example

# Owner sign-in (docs/specs/auth.md). Passed to the container as Blog__… variables.
# Blog__SetupToken=            32+ characters; claims the blog on first sign-in, then burns. A new one re-opens setup (recovery)
# Blog__Demo__Enabled=false    true: /demo lets visitors try the app on a hidden sample blog, every change refused
# Blog__Slug=blog              the blog's slug, at setup
# Blog__Title=My blog          the blog's title, at setup
# Blog__Auth__Google__ClientId= / Blog__Auth__Google__ClientSecret=     redirect <public url>/api/auth/google/callback
# Blog__Auth__Discord__ClientId= / Blog__Auth__Discord__ClientSecret=   redirect <public url>/api/auth/discord/callback
# Blog__Proxy__ForwardedForHops=1   behind one trusted proxy (Railway), for per-client rate limits
# Blog__Auth__Oidc__AllowPrivate=false   true lets the owner's own sign-in provider (set in the app) be on this server's network

# Media (docs/specs/media.md): any S3-compatible bucket. Off without the first four.
# Recommended: Cloudflare R2 (no egress fees): endpoint https://<account id>.r2.cloudflarestorage.com, region auto, url_style path.
# A Railway bucket works too (url_style virtual), but its egress is billed.
# Blog__Bucket__endpoint=https://storage.example.com   the store's origin, without the bucket
# Blog__Bucket__name=blog-media
# Blog__Bucket__access_key= / Blog__Bucket__secret_key=   may read, write and delete in that bucket
# Blog__Bucket__url_style=path      or virtual (<bucket>.<endpoint host>/<key>: Railway's buckets, AWS)
# Blog__Bucket__region=us-east-1    auto for R2
# Blog__Bucket__max_bytes=10485760  per picture
# Blog__Bucket__max_blog_bytes=1073741824   per blog, pending and trash included

# Secrets and notifications (docs/specs/notifications.md). Without the master key, no channel can be set up.
# Blog__Secrets__MasterKey=          32 random bytes: openssl rand -hex 32; keep a copy, values sealed under it need it
# Blog__Secrets__PreviousKeys=       comma-separated older keys, only while moving to a new one
# (With Docker Compose, put them in .env as BLOG_SECRETS_MASTER_KEY and BLOG_SECRETS_PREVIOUS_KEYS, and the bucket as
# BUCKET_ENDPOINT, BUCKET_NAME, BUCKET_ACCESS_KEY, BUCKET_SECRET_KEY, BUCKET_REGION, BUCKET_URL_STYLE: compose.yaml passes them.)
# Blog__Notify__Subject=             VAPID contact, mailto: or https:; default Blog__PublicUrl
# Blog__Notify__AllowPrivate=false   true lets channels reach this server's own network (a LAN ntfy or n8n)
# Blog__Notify__IntervalSeconds=10   how often the worker sends; 0 turns it off

# Being found (docs/specs/social.md). Each blog can turn it off in the app; these are the server's choices.
# Blog__IndexNow__Endpoint=https://api.indexnow.org/indexnow
# Blog__WebSub__Hub=https://pubsubhubbub.appspot.com/   empty turns WebSub off
# Blog__SearchPing__IntervalSeconds=60   0 turns the ping worker off

# Announcing new posts on the owner's social accounts (docs/specs/announce.md). Needs Blog__Secrets__MasterKey: the
# accounts' credentials are sealed with it. The wait before an announcement goes is set per blog in the app.
# Blog__Announce__IntervalSeconds=15   how often the worker makes and sends announcements; 0 turns it off

# Subscribe by email (docs/specs/subscribe.md): the owner connects Resend or SMTP in the app (Account → Announce → Email).
# Blog__Mail__IntervalSeconds=10       how often the worker sends queued mail; 0 turns it off
# Blog__Subscribe__PerMinute=5         tries a minute from one address on the subscribe form
