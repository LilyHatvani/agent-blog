<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AgentBlog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AgentKit.McpOAuth" Version="0.1.5" />
    <PackageReference Include="AgentKit.ProviderSignIn" Version="0.1.5" />
    <PackageReference Include="AgentKit.Channels" Version="0.1.13" />
    <PackageReference Include="AgentKit.Export" Version="0.1.12" />
    <PackageReference Include="AgentKit.Social" Version="0.1.13" />
    <PackageReference Include="AgentKit.Fetch" Version="0.1.13" />
    <PackageReference Include="AgentKit.Push" Version="0.1.9" />
    <PackageReference Include="AgentKit.Secrets" Version="0.1.9" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- SMTP for the subscribers' email (docs/specs/subscribe.md). 4.18.2: 5.0.0 is a new major, 12 days old on 2026-11-22. -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Fluid.Core" Version="3.0.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\Migrations\*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Public\Themes\**\*" LogicalName="themes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBlog.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link cards draw with these (Public/Cards/Fonts/README.md says which licence covers which). -->
    <EmbeddedResource Include="Public\Cards\Fonts\*.ttf;Public\Cards\Fonts\*.otf" LogicalName="cards/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
