<header class="term-head author-head">
  <p class="terms-label">Author</p>
  <h1>{{ author.name }}</h1>
  <p class="term-description">{{ author.post_count }} post{% if author.post_count != 1 %}s{% endif %}{% if author.agents.size > 0 %}, written with {% for a in author.agents %}{{ a }}{% unless forloop.last %}{% if forloop.rindex == 2 %} and {% else %}, {% endif %}{% endunless %}{% endfor %}{% endif %}.</p>
</header>
<ol class="posts">
{% for post in posts %}
  <li>
    <a class="post-title" href="{{ post.url }}">{{ post.title }}</a>
    <time datetime="{{ post.published_at }}">{{ post.published_display }}</time>
    {% if post.excerpt != "" %}<p>{{ post.excerpt }}</p>{% endif %}
    <p class="byline">{{ post.byline }}</p>
  </li>
{% endfor %}
</ol>
<nav class="pager">
  {% if page.newer_url %}<a rel="prev" href="{{ page.newer_url }}">Newer</a>{% endif %}
  {% if page.older_url %}<a rel="next" href="{{ page.older_url }}">Older</a>{% endif %}
  <a href="{{ blog.url }}">All posts</a>
</nav>
