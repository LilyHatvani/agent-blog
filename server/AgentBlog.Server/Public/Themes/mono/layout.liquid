<!doctype html>
<html lang="{{ blog.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }}</title>
{{ head_html | raw }}
<link rel="stylesheet" href="{{ theme.css_url }}">
{% if picker_html %}<link rel="stylesheet" href="/assets/themes/_picker.css">{% endif %}
</head>
<body class="theme-{{ theme.name }}">
{{ picker_html | raw }}
<header class="site">
  <p class="prompt"><span class="user">~/{{ blog.title | downcase | replace: " ", "-" }}</span> $ <a class="site-title" href="{{ blog.url }}">cat index</a><span class="cursor" aria-hidden="true">▌</span></p>
  <p class="site-name">{{ blog.title }}</p>
  {% if blog.description != "" %}<p class="site-description"># {{ blog.description }}</p>{% endif %}
</header>
<main>
{{ content | raw }}
</main>
<footer class="site">
  <a href="{{ blog.rss_url }}">[rss]</a> <a href="{{ blog.atom_url }}">[atom]</a> <a href="{{ blog.url }}">[home]</a>
</footer>
</body>
</html>
