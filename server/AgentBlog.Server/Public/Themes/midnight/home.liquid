{% if page.number == 1 %}<section class="masthead">
  {% if blog.description != "" %}<h1 class="lead">{{ blog.description }}</h1>{% else %}<h1 class="sr-only">{{ blog.title }}</h1>{% endif %}
</section>
{% endif %}{% if posts.size == 0 %}
<p class="empty">Nothing published yet. Soon.</p>
{% else %}
<ol class="rows">
{% for post in posts %}
  <li>
    <a class="row" href="{{ post.url }}">
      <time datetime="{{ post.published_at }}">{{ post.published_display }}</time>
      <span class="row-body">
        {% if post.categories.size > 0 %}<span class="eyebrow">{{ post.categories.first.name }}</span>{% endif %}
        <span class="row-title">{{ post.title }}</span>
        {% if post.excerpt != "" %}<span class="row-excerpt">{{ post.excerpt }}</span>{% endif %}
      </span>
    </a>
  </li>
{% endfor %}
</ol>
{% endif %}
{% if page.newer_url or page.older_url %}
<nav class="pager">
  {% if page.newer_url %}<a rel="prev" href="{{ page.newer_url }}">← Newer</a>{% endif %}
  {% if page.older_url %}<a rel="next" href="{{ page.older_url }}">Older →</a>{% endif %}
</nav>
{% endif %}
