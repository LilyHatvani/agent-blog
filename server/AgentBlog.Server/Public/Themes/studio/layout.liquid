<!doctype html>
<html lang="{{ blog.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }}</title>
{{ head_html | raw }}
<link rel="stylesheet" href="{{ theme.css_url }}">
{% if picker_html %}<link rel="stylesheet" href="/assets/themes/_picker.css">{% endif %}
{% if subscribe_form_html or subscribe %}<link rel="stylesheet" href="/assets/themes/_subscribe.css">{% endif %}
</head>
<body class="theme-{{ theme.name }}">
{{ picker_html | raw }}
<header class="band">
  <div class="band-inner">
    <a class="site-title" href="{{ blog.url }}">{{ blog.title }}</a>
    {% if blog.description != "" %}<p class="site-description">{{ blog.description }}</p>{% endif %}
    <nav class="band-nav"><a href="{{ blog.url }}">Posts</a><a href="{{ blog.rss_url }}">RSS</a><a href="{{ blog.atom_url }}">Atom</a></nav>{% if sections.size > 0 %}{{ nav_html | raw }}{% endif %}
  </div>
</header>
<main>
{{ content | raw }}
</main>
<footer class="site">
  <span>{{ blog.title }}</span>
  <span><a href="{{ blog.rss_url }}">RSS</a> · <a href="{{ blog.atom_url }}">Atom</a></span>
</footer>
</body>
</html>
