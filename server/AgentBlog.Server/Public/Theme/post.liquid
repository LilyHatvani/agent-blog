<article>
  <h1>{{ post.title }}</h1>
  <time datetime="{{ post.published_at }}">{{ post.published_display }}</time>
  <div class="body">
{{ post.body_html | raw }}
  </div>
{% if post.categories.size > 0 or post.tags.size > 0 %}
  <footer class="terms">
{% if post.categories.size > 0 %}    <p><span class="terms-label">Filed under</span> {% for c in post.categories %}<a href="{{ c.url }}">{{ c.name }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
{% endif %}{% if post.tags.size > 0 %}    <p class="tags">{% for t in post.tags %}<a class="tag" href="{{ t.url }}">#{{ t.name }}</a>{% endfor %}</p>
{% endif %}  </footer>
{% endif %}
</article>
<nav class="pager"><a href="{{ blog.url }}">All posts</a></nav>
